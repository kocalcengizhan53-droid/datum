{
  "name": "datum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3300",
    "start": "npx --yes serve@14.2.6 out -l 3300",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "qa": "node qa/shot.mjs && node qa/invisible.mjs && node qa/type.mjs && node qa/ar.mjs && node qa/keyboard.mjs",
    "build:ar": "node scripts/build-ar.mjs",
    "posters": "node scripts/cover-posters.mjs",
    "prebuild": "npm run build:ar",
    "deploy": "npm run build && wrangler pages deploy out --project-name=datum-journal --branch=main",
    "qa:axe": "node qa/axe.mjs",
    "qa:lighthouse": "node qa/lighthouse.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gray-matter": "^4.0.3",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  }
}
